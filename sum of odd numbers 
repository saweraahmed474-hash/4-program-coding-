// Q4. Write a program to calculate the sum of all odd numbers between 1 and 50.
#include <iostream>
using namespace std;

int main() {
    int sum = 0;
    for (int i = 1; i <= 50; i++) {
        if (i % 2 != 0) {
            sum = sum + i;
        }
    }
    cout << "Sum of odd numbers = " << sum;
    return 0;
}